!<arch>
//                                              20        `
scheduler_test.ml/

scheduler.ml/   0           0     0     644     1097      `
open Netlist_ast
open Graph

exception Combinational_cycle

let read_exp ((_, rhs): equation) =
  List.filter_map
  (function
    | Avar v -> Some v
    | Aconst _ -> None)
  (match rhs with
    | Ereg _ -> []
    | Earg a | Enot a | Erom (_, _, a) | Eslice (_, _, a) | Eselect (_, a) -> [a]
    | Ebinop (_, a1, a2) | Econcat (a1, a2) -> [a1; a2]
    | Emux (a1, a2, a3) -> [a1; a2; a3]
    | Eram (_, _, a1, a2, a3, a4) -> [a1; a2; a3; a4])

let schedule p =
  let g_deps = mk_graph () in
  List.iter (add_node g_deps) (List.map fst @@ Env.to_list p.p_vars);
  p.p_eqs |> List.iter (fun eq ->
    let output, _ = eq in
    let inputs = read_exp eq in
    List.iter (fun input -> add_edge g_deps input output) inputs);
  try
    let order = topological g_deps in
    let c_order = Hashtbl.create 97 in (* compiled order: ident -> int reprsenting order *)
    List.iteri (fun i v -> Hashtbl.add c_order v i) order;
    {p with
      p_eqs = List.sort (fun (v1, _) (v2, _) -> compare (Hashtbl.find c_order v1) (Hashtbl.find c_order v2)) p.p_eqs
    }
  with
  | Cycle -> raise Combinational_cycle


/0              0           0     0     644     1304      `
let print_only = ref false
let number_steps = ref (-1)

let compile filename =
  try
    let p = Netlist.read_file filename in
    let out_name = (Filename.chop_suffix filename ".net") ^ "_sch.net" in
    let out = open_out out_name in
    let close_all () =
      close_out out
    in
    begin try
        let p = Scheduler.schedule p in
        Netlist_printer.print_program out p;
      with
        | Scheduler.Combinational_cycle ->
            Format.eprintf "The netlist has a combinatory cycle.@.";
            close_all (); exit 2
        | e -> Format.eprintf "The detection of a combinatorial cycle should raise the Combinatorial_cycle exception; otherwise, fix this one@."; raise e
    end;
    close_all ();
    if not !print_only then (
      let simulator =
        if !number_steps = -1 then
          "./prebuilt_netlist_simulator.byte"
        else
          "./prebuilt_netlist_simulator.byte -n "^(string_of_int !number_steps)
      in
      ignore (Unix.system (simulator^" "^out_name))
    )
  with
    | Netlist.Parse_error s -> Format.eprintf "An error occurred: %s@." s; exit 2

let main () =
  Arg.parse
    ["-print", Arg.Set print_only, "Only print the result of scheduling";
     "-n", Arg.Set_int number_steps, "Number of steps to simulate"]
    compile
    ""
;;

main ()
